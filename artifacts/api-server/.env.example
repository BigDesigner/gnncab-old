# ==============================================================================
# GNNcab API Server Environment Variables
# ==============================================================================

# ─── Server Configuration ─────────────────────────────────────────────────────
# The port the API server will listen on.
PORT=5000

# Must be "production" for production deployments to enable secure cookies, etc.
NODE_ENV=production

# ─── Security & Authentication ────────────────────────────────────────────────
# Comma-separated list of allowed origins. NO WILDCARDS in production.
ALLOWED_ORIGINS=https://gnncab.com,https://www.gnncab.com

# 64+ character random string for signing JWT tokens.
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# JWT expiration. Default is 12h if not set.
JWT_EXPIRES_IN=12h

# Domain for auth cookies to support cross-subdomain auth (e.g. .gnncab.com)
AUTH_COOKIE_DOMAIN=.gnncab.com

# ─── Routing & Dispatch ───────────────────────────────────────────────────────
# "osrm" is required in production. "mock" is allowed only in development.
ROUTING_PROVIDER=osrm

# URL of the OSRM routing engine API.
OSRM_BASE_URL=http://localhost:5001

# ─── Database ─────────────────────────────────────────────────────────────────
# Connection string for PostgreSQL database. Required by @workspace/db.
DATABASE_URL=postgresql://gnncab:password@localhost:5432/gnncab

# ─── Optional Services ────────────────────────────────────────────────────────
# Redis connection URL for multi-instance scaling. If omitted, falls back to
# single-instance memory pub/sub.
# REDIS_URL=redis://localhost:6379
